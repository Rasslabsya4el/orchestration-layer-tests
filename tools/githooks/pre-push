#!/bin/sh
# Refuses a plain push of main (#379). main is pushed only by python -m tools.agentops commit / merge,
# which set AGENTOPS_MAIN_PUSH=1 in the env of their own push.
# #422: every commit of every pushed ref is read for a GitHub closing keyword before a ticket reference
# (python -m tools.agentops closing-check). A hit refuses the push; a check that cannot run lets it through
# with a warning. A deleted ref has no commit to read.
refs=$(cat)

is_zero() {
    case "$1" in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

# $1 exit code of the check, $2 its stderr, $3 what was checked
judge() {
    case "$2" in
        *"closes the ticket on GitHub"*)
            if [ "$1" = "1" ]; then
                printf 'pre-push: a closing keyword before a ticket reference in %s (#422)\n%s\n' "$3" "$2" >&2
                hit=1
                return
            fi ;;
    esac
    if [ "$1" != "0" ]; then
        printf 'pre-push: warning: the closing check did not run for %s (exit %s); the push goes on (#422)\n' "$3" "$1" >&2
    fi
}

# $1 = A..B
check_range() {
    err=$(python -m tools.agentops closing-check --range "$1" 2>&1 >/dev/null </dev/null)
    judge "$?" "$err" "$1"
}

# $1 = a commit sha, read by its message alone (no range to name it by)
check_commit() {
    err=$(git log -1 --format=%B "$1" | python -m tools.agentops closing-check --stdin 2>&1 >/dev/null)
    judge "$?" "$err" "commit $1"
}

hit=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    is_zero "$local_sha" && continue
    if ! is_zero "$remote_sha"; then
        check_range "$remote_sha..$local_sha"
    elif git rev-parse -q --verify origin/main >/dev/null 2>&1; then
        check_range "origin/main..$local_sha"
    else
        for sha in $(git rev-list "$local_sha" --not --remotes 2>/dev/null); do
            check_commit "$sha"
        done
    fi
done <<EOF
$refs
EOF
[ "$hit" = "1" ] && exit 1

[ "$AGENTOPS_MAIN_PUSH" = "1" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "pre-push: a plain push of main is refused; main is pushed only through python -m tools.agentops commit (or merge) (#379)" >&2
        exit 1
    fi
done <<EOF
$refs
EOF
exit 0
